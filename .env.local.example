# Kopiera denna fil till .env.local och fyll i värdena.
# .env.local får ALDRIG committas (den ligger i .gitignore).

# ===== Supabase =====
# Hämta från Supabase Dashboard → Project Settings → Database → Connection string
# Pooled connection (port 6543) — används av appen i runtime
DATABASE_URL=postgresql://postgres.PROJECTREF:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (port 5432) — används av drizzle-kit push (DDL behöver direct)
DIRECT_URL=postgresql://postgres.PROJECTREF:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ===== Cron (sätts senare i M12) =====
# Slumpmässig sträng som skyddar /api/cron/* endpoints
CRON_SECRET=
